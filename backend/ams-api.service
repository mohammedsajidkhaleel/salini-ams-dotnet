[Unit]
Description=Salini AMS ASP.NET Core API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/ams/api
ExecStart=/usr/bin/dotnet /var/www/ams/api/salini.api.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=yourapp-api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
# Database connection string - set this with your actual database credentials
Environment=ConnectionStrings__DefaultConnection="Host=localhost;Database=ams;Username=ams;Password=qwerty;Port=5432"

# Timeout settings - increased for database operations during startup
TimeoutStartSec=300
TimeoutStopSec=30

# Resource limits
LimitNOFILE=65536

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

